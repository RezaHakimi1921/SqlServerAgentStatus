# Optional — you can also configure via the web UI on first run.
# Password is NOT stored here — it goes to Windows Credential Manager.
SQL_SERVER=your_server_ip
SQL_DATABASE=msdb
SQL_USER=your_username
SQL_DRIVER=17
SQL_ENCRYPT=no
SQL_TRUST_CERT=yes
SQL_TIMEOUT=10
REFRESH_MINUTES=5
# UI language: en | fa
UI_LOCALE=en
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Insight Metric Store (SmartMonitorDB) — collector
MONITOR_DATABASE=SmartMonitorDB
INSIGHT_COLLECTOR_ENABLED=1
# Index Advisor Phase 1 — per-target ODBC strings (no passwords in git)
# SQL_CONN_DEV_PRIMARY=DRIVER={ODBC Driver 17 for SQL Server};SERVER=...;DATABASE=master;UID=...;PWD=...;TrustServerCertificate=yes;
# INDEX_ADVISOR_PAGE_COUNT_MIN=100
# INDEX_ADVISOR_READONLY=1
# Optional per-metric interval overrides (seconds, min 10):
# INSIGHT_INTERVAL_BLOCKING_WAIT_MS=10
# INSIGHT_INTERVAL_JOB_FAILED=60
